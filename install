#!/usr/bin/env bash

yesno() {
    read -p "$1 [y/N] " REPLY
    case "$REPLY" in
        *[yY]*) return 0;;
        *) return 1;;
    esac
}

# Max number of diff lines to show inline; longer diffs are offered in a pager.
DIFF_MAX_LINES=$(( $(tput lines 2>/dev/null || echo 24) / 2 ))

# showdiff OLD NEW [--pager]
showdiff() {
    if command -v git >/dev/null 2>&1; then
        if [ "$3" = "--pager" ]; then
            git -c core.pager="${PAGER:-less -R}" diff --no-index -- "$1" "$2"
        else
            git --no-pager diff --no-index --color=auto -- "$1" "$2"
        fi
    elif [ "$3" = "--pager" ]; then
        diff -u "$1" "$2" | ${PAGER:-less}
    else
        diff -u "$1" "$2"
    fi
}

# confirm_overwrite NEW EXISTING
# Shows how EXISTING would change (inline if short, else on request in a
# pager) and asks whether to overwrite it.
confirm_overwrite() {
    local NAME NLINES
    NAME=$(basename "$2")
    NLINES=$(diff -u "$2" "$1" | wc -l)

    if [ "$NLINES" -le "$DIFF_MAX_LINES" ]; then
        echo "$NAME exists and differs:"
        showdiff "$2" "$1"
        yesno "Overwrite $NAME?"
        return
    fi

    while true; do
        read -p "$NAME exists and differs ($NLINES diff lines). Overwrite? [y/N/d=show diff] " REPLY
        case "$REPLY" in
            [dD]*) showdiff "$2" "$1" --pager;;
            [yY]*) return 0;;
            *) return 1;;
        esac
    done
}

DIR=$(cd $(dirname $0) && pwd)

for APP_DIR in $DIR/config/*; do
    [ -d "$APP_DIR" ] || continue

    APP=$(basename "$APP_DIR")

    for i in $APP_DIR/*; do
        REALFILE=$HOME/.config/$APP/`basename "$i"`

        # skip executables
        [ -x "$i" ] && continue

        # skip directories
        [ -d "$i" ] && continue

        # skip already hardlinked files
        if [ "$i" -ef "$REALFILE" ]; then
            continue
        fi

        mkdir -p "$HOME/.config/$APP"

        if [ -f "$REALFILE" ]; then
            if cmp -s "$REALFILE" "$i"; then
                # same content: just relink
                ln -f "$i" "$REALFILE"
                continue
            fi

            if confirm_overwrite "$i" "$REALFILE"; then
                BACKUP="$REALFILE.backup-`date +%F`"
                echo "Backing up to $BACKUP ..."
                mv "$REALFILE" "$REALFILE.backup-`date +%F`"
            else
                continue
            fi
        fi

        ln "$i" "$REALFILE"
    done
done

# Handle files directly in config/ (not in subdirectories)
for i in $DIR/config/*; do
    [ -f "$i" ] || continue
    REALFILE=$HOME/.config/$(basename "$i")

    # skip executables
    [ -x "$i" ] && continue

    # skip already hardlinked files
    if [ "$i" -ef "$REALFILE" ]; then
        continue
    fi

    mkdir -p "$HOME/.config"

    if [ -f "$REALFILE" ]; then
        if cmp -s "$REALFILE" "$i"; then
            # same content: just relink
            ln -f "$i" "$REALFILE"
            continue
        fi

        if confirm_overwrite "$i" "$REALFILE"; then
            BACKUP="$REALFILE.backup-$(date +%F)"
            echo "Backing up to $BACKUP ..."
            mv "$REALFILE" "$BACKUP"
        else
            continue
        fi
    fi

    ln "$i" "$REALFILE"
done

for i in $DIR/*; do
    REALFILE=$HOME/.`basename "$i"`
    BASENAME=$(basename "$i")

    # skip executables
    [ -x "$i" ] && continue

    # skip directories
    [ -d "$i" ] && continue

    if [ "${i##*.}" = "plist" ]; then
        if [ `uname -s` != "Darwin" ]; then
            continue
        fi
        defaults import ${BASENAME%.*} "$i"
        continue
    fi

    if [ `basename "$i"` = "DefaultKeyBinding.dict" ]; then
        if [ `uname -s` = "Darwin" ]; then
            mkdir -p $HOME/Library/KeyBindings
            REALFILE=$HOME/Library/KeyBindings/DefaultKeyBinding.dict
        else
            continue
        fi
    fi

    # skip already hardlinked files
    if [ "$i" -ef "$REALFILE" ]; then
        continue
    fi

    if [ -f "$REALFILE" ]; then
        if cmp -s "$REALFILE" "$i"; then
            # same content: just relink
            ln -f "$i" "$REALFILE"
            continue
        fi

        if confirm_overwrite "$i" "$REALFILE"; then
            BACKUP="$REALFILE.backup-`date +%F`"
            echo "Backing up to $BACKUP ..."
            mv "$REALFILE" "$REALFILE.backup-`date +%F`"
        else
            continue
        fi
    fi

    ln "$i" "$REALFILE"
done

# Load dconf settings if dconf is available
if command -v dconf >/dev/null 2>&1 && [ -d "$DIR/dconf" ]; then
    for i in "$DIR/dconf"/*.conf; do
        [ -f "$i" ] || continue
        if yesno "Load dconf settings from $(basename "$i")?"; then
            dconf load / < "$i"
            echo "Loaded $(basename "$i")"
        fi
    done
fi
